# ============================================================================
# Villheva — static Nuxt build on Apache (domene.no)
#
# Copied verbatim from frontend/public/ into .output/public/ by `nuxt generate`,
# so it deploys with the site. Edit it here, never on the server.
# ============================================================================

# The prerender writes /products.html, not /products/index.html, so let the
# rewrites below decide what to serve rather than Apache guessing.
Options -MultiViews
DirectoryIndex index.html

# Nuxt writes a payload beside each route (/about/_payload.json), so a real
# "about" directory sits next to about.html. Without this, mod_dir would 301
# /about to /about/ before the rewrites below ever run, and every page would
# redirect into a directory that has no index.
DirectorySlash Off

# The PHP endpoints' shared code and credentials are never web-accessible.
RedirectMatch 404 ^/api/lib(/.*)?$

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Canonical scheme and host ---------------------------------------------
  # Every canonical/og:url the site emits is https + www; anything else 301s.
  # X-Forwarded-Proto is checked too so a TLS-terminating proxy can't loop.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.villheva.no%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.villheva.no%{REQUEST_URI} [R=301,L]

  # --- Form endpoints ---------------------------------------------------------
  # Keeps the client calling /api/contact and /api/order exactly as it does
  # against the Nuxt dev server. Internal rewrite, so the POST body survives.
  RewriteRule ^api/contact/?$ /api/contact.php [L]
  RewriteRule ^api/order/?$   /api/order.php   [L]

  # --- Drop trailing slashes so the served URL matches the canonical tag -----
  # No directory on this site is meant to be browsed, so this applies to the
  # payload directories too.
  RewriteRule ^(.+?)/$ /$1 [R=301,L]

  # --- Serve the prerendered page for an extensionless URL -------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# --- Caching -----------------------------------------------------------------
# Everything under /_nuxt/ is content-hashed (7b_AireS.js, entry.DXlsFGVF.css),
# so a given filename's bytes never change. Matched by path rather than by
# filename shape, because most chunk names are a bare hash with no extension
# prefix to anchor on.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/_nuxt/" NUXT_IMMUTABLE_ASSET
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=NUXT_IMMUTABLE_ASSET

  # HTML must revalidate or a Sanity edit would never reach returning visitors.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(xml|txt|json)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Unhashed files in public/ — long enough to help, short enough to replace.
  <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Compression -------------------------------------------------------------
# There is no CDN in front of this host, so compress at the origin.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>
